# Copy to .env.local for local development.

# Origin of the Go backend API. The frontend sends the session cookie with
# every request, so this must be an exact origin the backend allows via
# CORS_ORIGIN. Defaults to http://localhost:8080 when unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Dev convenience: show a "Log in as admin" button on the login screen that
# signs in with the credentials below. Off unless set to 1 or true. Never
# enable this in a deployed build — the credentials are inlined into the
# client bundle.
NEXT_PUBLIC_DEV_LOGIN=0
# Credentials the button submits. Username defaults to "admin"; the password
# has no default — set it to match your backend's ADMIN_PASSWORD.
# NEXT_PUBLIC_DEV_USERNAME=admin
# NEXT_PUBLIC_DEV_PASSWORD=
