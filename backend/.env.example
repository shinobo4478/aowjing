# Copy to .env for local development. cmd/api reads these on startup.

# HTTP listen address for the API server.
PORT=8080

# Postgres connection string. Matches the service in docker-compose.yml.
DATABASE_URL=postgres://acmp:acmp@localhost:5432/acmp?sslmode=disable

# Allowed CORS origin for the frontend dev server. Credentials are sent, so
# this must be a concrete origin (no "*").
CORS_ORIGIN=http://localhost:3000

# Single admin login. ADMIN_PASSWORD is required; the server won't start
# without it. Change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Set to true when frontend and API are on different HTTPS sites, so the
# session cookie is sent Secure + SameSite=None. Leave false for local http.
COOKIE_SECURE=false
