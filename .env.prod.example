# Copy to .env.prod and fill in. Used two ways:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#   - --env-file feeds ${...} substitution in the compose file
#   - `env_file: .env.prod` injects the same vars into api + worker
# .env.prod is git-ignored (.gitignore: .env*). Keep it on the server only.

# ---- Public address -------------------------------------------------------
# A domain (with DNS A/AAAA pointing here) → automatic HTTPS.
# Or ":80" for a plain-HTTP test against the server's IP.
SITE_ADDRESS=acmp.example.com

# ---- Postgres -----------------------------------------------------------
POSTGRES_USER=acmp
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=acmp

# ---- Admin login (single user) ---------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-long-random

# ---- Session cookie --------------------------------------------------
# true in production: cookie is sent Secure (HTTPS only).
COOKIE_SECURE=true

# Same-origin deploy, but the API's CORS check still runs — set it to the
# real origin. Must match SITE_ADDRESS's scheme + host, no trailing slash.
CORS_ORIGIN=https://acmp.example.com

# ---- Generator -----------------------------------------------------------
# 1 = fake fal.ai (sample video, no key needed). 0 = real calls; the key is
# entered on the Settings screen, not here.
AI_FAKE_FAL=1
FAL_MODEL=fal-ai/kling-video/v3/standard/text-to-video

# PORT is fixed to 8080 inside the api container — don't set it here.
